# The default transport is stdio. Use http for Streamable HTTP.
TRANSPORT=stdio
HOST=127.0.0.1
PORT=8000
HTTP_PATH=/mcp
LOG_LEVEL=INFO

# JSON list of unique, nonblank tokens. Required for non-loopback HTTP binds.
AUTH_TOKENS=[]

# Provider map. Exact $NAME values resolve from the process environment.
PROVIDERS={}

ROUTER__MAX_PROVIDERS=3
ROUTER__DEFAULT_TIMEOUT_SECONDS=20
RESULTS__MAX_RESULTS=20
RESULTS__RECIPROCAL_RANK_K=60
